# my_secrets 模板（由 deploy.sh 讀取；不要放密碼進來，密碼用環境變數）
# 產生的 my_secrets.py 只會存在樹莓派上，不進 git。
#
# deploy.sh 會替換的欄位：BROKER PORT TRANSPORT USE_TLS WS_PATH CA_CERTS
#   USERNAME PASSWORD TOPIC RECEIVER_NO USE_TEST_MODE
# 值以 json.dumps 填入，None / True / 數字 / 字串都合法。
mqtt_env = {
    "broker": @BROKER@,
    "port": @PORT@,
    "transport": @TRANSPORT@,
    "use_tls": @USE_TLS@,
    "ws_path": @WS_PATH@,
    "ca_certs": @CA_CERTS@,
    "username": @USERNAME@,
    "password": @PASSWORD@,
    "topic": @TOPIC@,
}

# 這台是第幾號接收器 → MQTT topic <topic>/receivers/<RECEIVER_NO>，三台必須不同
RECEIVER_NO = @RECEIVER_NO@

# 測試模式：True = 用固定 TEST_KEY_2024 離線測試，False = 需向後端 API 取得 XOR Key
USE_TEST_MODE = @USE_TEST_MODE@
